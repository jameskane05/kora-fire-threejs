{
  "name": "kora-fire-threejs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "vite build && cd dist && touch .nojekyll && git init -q && git add -A && git commit -qm 'Publish' && git push -qf git@github.com:jameskane05/kora-fire-threejs.git HEAD:gh-pages"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
